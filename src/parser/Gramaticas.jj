Expression Expression():
{
    SimpleExpression left=null,right=null;
    DataType returnType=null;
    Token operator=null;
 }
{
    //La gramatica comentada soporta el uso de la palabra reservada IN para trabajar con conjuntos.
    //SimpleExpression() ((<EQ_OP> | <LT_OP> | <GT_OP> | <NEQ_OP> | <LE_OP> | <GE_OP> | <IN_KEYWORD>) SimpleExpression() )?
    left=SimpleExpression() ((operator=<EQ_OP> |operator=<LT_OP> | operator=<GT_OP> | operator=<NEQ_OP> | operator=<LE_OP> | operator=<GE_OP>) right=SimpleExpression()
    {
        returnType=left.getReturnType();
        if(semanticAnalyzer.checkExpression(left,right,operator.beginLine)){
                returnType = DataType.BOOLEAN;
                return new Expression(returnType,operator.image,left,right);
        }
    }
    )?

    {
    return new Expression(left.getReturnType(),left);
    }
}

SimpleExpression SimpleExpression():
{
    Token sign=null,op=null;
    Term firstTerm = null,curr=null,prev=null;
    ArrayList<Term> otherTerms= new ArrayList<>();
    ArrayList<String> operators = new ArrayList();
    boolean simpleExpressionIsValid=true;
 }
{
    //Solo se incluye "or", "+" y "-" a este nivel
    // por la precedencia de los operadores
    // para el orden de evaluación
    (sign=<ADD_OP> | sign=<SUB_OP>)?
    firstTerm=Term()
    {
        prev=firstTerm;
        if(sign!=null && !semanticAnalyzer.termIsNumeric(firstTerm)){
            errorLog.logSemanticError(sign.beginLine,"No se puede aplicar el signo "+sign.image+" a un valor no numerico");
        }
    }
     ( ( op=<OR_KEYWORD> |op=<ADD_OP> | op=<SUB_OP> ) curr=Term()
        {
            if(op.image.toLowerCase()=="or"){
                if(!semanticAnalyzer.termIsBoolean(prev) || !semanticAnalyzer.termIsBoolean(curr)){
                    errorLog.logSemanticError(op.beginLine,"No se puede aplicar la operacion OR a tipos no booleanos");
                    simpleExpressionIsValid=false;
                }
            }else{
                if(!semanticAnalyzer.termIsNumeric(prev) || !semanticAnalyzer.termIsNumeric(curr)){
                    errorLog.logSemanticError(op.beginLine,"No se puede aplicar la operacion "+op.image+" a tipos no numericos");
                    simpleExpressionIsValid=false;
                }
            }
            operators.add(op.image);
            otherTerms.add(curr);
            prev=curr;
        }
     )*
    {
        if(simpleExpressionIsValid) return new SimpleExpression(firstTerm,otherTerms,operators);
        return new SimpleExpression();
    }
}


Term Term():
{
    Factor firstFactor = null,curr=null,prev=null;
    ArrayList<Factor> otherFactors = new ArrayList<>();
    ArrayList<String> operators = new ArrayList();
    Token op=null;
    boolean termIsValid=true;
}
{
    firstFactor=Factor() {prev=firstFactor;}
    ((op=<MUL_OP> | op=<DIV_OP> | op=<DIV_KEYWORD> |op=<MOD_KEYWORD> | op=<AND_KEYWORD>)
    curr=Factor() {
        if(op.image.toLowerCase() == "and"){
            if(!semanticAnalyzer.factorIsBoolean(prev) || !semanticAnalyzer.factorIsBoolean(curr)){
                errorLog.logSemanticError(op.beginLine,"No se puede aplicar la operacion AND a tipos no booleanos");
                termIsValid=false;
            }
        }else{
            if(!semanticAnalyzer.factorIsNumeric(prev) || !semanticAnalyzer.factorIsNumeric(curr)){
                errorLog.logSemanticError(op.beginLine,"No se puede aplicar la operacion "+op.image+" a tipos no numericos");
                termIsValid=false;
            }
        }
        operators.add(op.image);
        otherFactors.add(curr);
        prev=curr;
    }
    )*

    {
        if(termIsValid) return new Term(firstFactor,operators,otherFactors);
        return new Term();
    }
}

Factor Factor():
{
        Variable variable=null;
        UnsignedConstant unsignedConstant=null;
        Expression expr = null;
        Factor factor = null;
        Token lparen=null,rparen=null;
}
{
    //La gramatica comentada acepta las llamadas a funciones como un factor para una expresion
    //FunctionCall() | <IDENTIFIER>  | Constant() | Variable() | UnsignedConstant() | <LPAREN> Expression() <RPAREN> | <NOT_KEYWORD> Factor() | <LBRACKET> Expression() (<RANGE_OP> Expression())? (<COMMA> Expression() (<RANGE_OP> Expression())?)* <RBRACKET>
     (variable=Variable() {return new Factor(variable);}
    | unsignedConstant=UnsignedConstant() {return new Factor(unsignedConstant);}
    | <LPAREN> expr=Expression() <RPAREN> { return new Factor(expr,(lparen!=null && rparen!=null) ? true:false);}
    | <NOT_KEYWORD> factor=Factor(){return new Factor(factor);})

    {return new Factor();}
}

Constant Constant():
{
    Token sign=null,identifier=null,charConstant=null,stringConstant=null;
    UnsignedNumber unsignedNumber=null;
 }
{
    (
    ((sign=<ADD_OP> | sign=<SUB_OP>)? (

    identifier=<IDENTIFIER>{
        DataType dt = symbolTable.getDataType(identifier.image);
        if(dt!=null && semanticAnalyzer.checkConstant(dt,sign.image,identifier.beginLine)){
            return new Constant(identifier.image,dt,sign.image);
        }
    }
    | unsignedNumber=UnsignedNumber() { return new Constant(unsignedNumber.getValue(),symbolTable.getDataType(identifier.image),sign.image);})
    )
    | charConstant=<CHAR_CONSTANT> {return new Constant(charConstant.image,DataType.CHAR);}
    | stringConstant=<STRING_CONSTANT> {return new Constant(stringConstant.image,DataType.STRING);}
    )

    {return new Constant();}
}


UnsignedConstant UnsignedConstant():
{
   Token identifier=null,charLiteral=null,stringLiteral=null,booleanLiteral=null;
   UnsignedNumber numericLiteral = null;
    String val;DataType type;
}
{
    (identifier=<IDENTIFIER> {
        if(semanticAnalyzer.checkSymbolExists(identifier.image, identifier.beginLine)){
            return new UnsignedConstant(
                identifier.image,
                symbolTable.getDataType(identifier.image)
            );
        }
    }
    | numericLiteral=UnsignedNumber() {return new UnsignedConstant(numericLiteral.getValue(), numericLiteral.getType());}/*| <NIL_KEYWORD> */
    | charLiteral=<CHAR_CONSTANT> {return new UnsignedConstant(charLiteral.image, DataType.CHAR);}
    | stringLiteral=<STRING_CONSTANT> {return new UnsignedConstant(stringLiteral.image,DataType.STRING);})
    | (booleanLiteral=<TRUE_KEYWORD> | booleanLiteral=<FALSE_KEYWORD> ) {return new UnsignedConstant(booleanLiteral.image,DataType.BOOLEAN);}

    {return new UnsignedConstant();}
}

UnsignedNumber UnsignedNumber():
{
    Token numericLiteral;
    DataType dataType;
}
{
    (numericLiteral=<INTEGER_CONSTANT> {dataType = DataType.INTEGER;}
    | numericLiteral=<REAL_CONSTANT> {dataType = DataType.REAL;})

    {return new UnsignedNumber(numericLiteral.image, dataType);}
}


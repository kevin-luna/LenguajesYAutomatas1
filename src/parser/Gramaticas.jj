ForStatement ForStatement():
{
        semanticStack.pushBlock(BlockType.FOR_BLOCK);
        Expression expr=null,expr2=null;
        Token forKeyword=null;
        Variable variable = null;
        Token mode = null;
        Statement stmt=null;
        CodeBlock codeBlock=null;
}
{
    try{

    forKeyword=<FOR_KEYWORD> variable=Variable() <ASSIGN_OP> expr=Expression() (mode=<DOWNTO_KEYWORD> | mode=<TO_KEYWORD> ) expr2=Expression() <DO_KEYWORD> (stmt=Statement() | codeBlock=CodeBlock() <SEMICOLON> )
    {
    if(!semanticAnalyzer.checkConstReassignment(variable.getName())
    && variable.getDataType()==DataType.INTEGER
    && symbolTable.getSymbolType(variable.getName())!=SymbolType.ARRAY
    && semanticAnalyzer.checkAssignment(variable,expr)
    && expr2.getReturnType()==DataType.INTEGER
    ){
        ForMode forMode=mode.image.toLowerCase().toLowerCase().equals("to") ? ForMode.TO:ForMode.DOWNTO;
        semanticStack.popBlock();
        if(stmt!=null) return new ForStatement(variable,expr,forMode,expr2,stmt);
        return new ForStatement(variable,expr,forMode,expr2,codeBlock);
    }
    semanticStack.popBlock();
    return new ForStatement();
}
    }catch(ParseException paex){
             errorLog.logSyntaxError(paex);
             return new ForStatement();
     }
}

BreakStatement BreakStatement():
{Token keyword=null;}
{
    try{

    keyword=<BREAK_KEYWORD> <SEMICOLON>

    {
        if(keyword!=null && !semanticAnalyzer.checkInsideLoop()){
            errorLog.logSemanticError(keyword.beginLine,"Sentencia "+keyword.image+" fuera de un ciclo");
            return null;
        }
        return new BreakStatement();
    }
    }catch(ParseException paex){
         errorLog.logSyntaxError(paex);
         return new BreakStatement();
     }
}

ContinueStatement ContinueStatement():
{Token keyword=null;}
{
    try{

    keyword=<CONTINUE_KEYWORD> <SEMICOLON>

    {
        if(keyword!=null && !semanticAnalyzer.checkInsideLoop()){
            errorLog.logSemanticError(keyword.beginLine,"Sentencia "+keyword.image+" fuera de un ciclo");
            return null;
        }
        return new ContinueStatement();
    }
    }catch(ParseException paex){
         errorLog.logSyntaxError(paex);
         return new ContinueStatement();
     }
}


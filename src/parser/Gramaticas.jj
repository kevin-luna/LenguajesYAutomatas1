//<USES_KEYWORD> <IDENTIFIER> <SEMICOLON>
//}

Block Block():
{
   Block block = null;
}
{
    //La gramatica comentada soporta la creacion de procedimientos y funciones
    //CodeBlock() | ConstBlock()  | VarBlock() | Procedure() | Function()
    try{
    block=CodeBlock() | block=ConstBlock()  | block=VarBlock()
    }catch(ParseException paex){
        errorLog.logSyntaxError(paex);
        return new Block();
    }
    {return block;}
}

VarBlock VarBlock() :
{
    this.semanticStack.pushBlock(BlockType.VAR_BLOCK);
    ArrayList<VariableDeclaration> variables= new ArrayList<>();
    ArrayList<VariableDeclaration> tmp = null;
}
{
    <VAR_KEYWORD> (
            try{
            tmp=VariableDeclaration(){
                variables.addAll(tmp);
            }
            }catch(ParseException paex){
                errorLog.logSyntaxError(paex);
            }
        )*
    {
        this.semanticStack.popBlock();
        return new VarBlock(variables);
    }
}

ConstBlock ConstBlock() :
{
     semanticStack.pushBlock(BlockType.CONST_BLOCK);
    Token identifier=null,typeIdentifier=null;
    Constant constant=null;
     String constName = "";
     SymbolEntry newConstant = null;
     ArrayList<ConstDeclaration> constants = new ArrayList<>();
     boolean ok = true;
}
{
    <CONST_KEYWORD> (
        try{
            identifier=<IDENTIFIER>
        }catch(ParseException paex){
            errorLog.logSyntaxError(paex);
            ok=false;
        }

        try{
            <COLON>
        }catch(ParseException paex){
            errorLog.logSyntaxError(paex);
            ok=false;
        }

        try{
            typeIdentifier=TypeIdentifier()
        }catch(ParseException paex){
            errorLog.logSyntaxError(paex);
            ok=false;
        }

        try{
            <EQ_OP>
        }catch(ParseException paex){
            errorLog.logSyntaxError(paex);
            ok=false;
        }

        try{
            constant=Constant()
        }catch(ParseException paex){
            errorLog.logSyntaxError(paex);
            ok=false;
        }

        try{
              <SEMICOLON>
        }catch(ParseException paex){
            errorLog.logSyntaxError(paex);
            ok=false;
        }
    )*

    {
        if(ok){
              newConstant = new SymbolEntry(
                                                      identifier.image,
                                                      constant.getValue(),
                                                      identifier.beginLine,
                                                      SymbolType.CONSTANT,
                                                      DataTypes.getDataType(typeIdentifier.image),
                                                      1,
                                                      0
                                );
            if(!semanticAnalyzer.checkConstantRedefinition(newConstant)){
                symbolTable.addSymbol(newConstant);
                constants.add(new ConstDeclaration(identifier.image,DataTypes.getDataType(typeIdentifier.image)),constant.getValue());
            }

        }
        semanticStack.popBlock();
        return new ConstBlock(constants);
    }
}

CodeBlock CodeBlock() :
{
    this.semanticStack.pushBlock(BlockType.CODE_BLOCK);
    ArrayList<Statement> statements = new ArrayList<>();
    Statement tmp=null;
}
{
//   try{
  <BEGIN_KEYWORD>
  (
    try{
        tmp=Statement() {statements.add(tmp);}
    }catch(ParseException paex){
        errorLog.logSyntaxError(paex);
    }
  )*
  try{
    <END_KEYWORD>
  }catch(ParseException paex){
    errorLog.logSyntaxError(paex);
  }
//  }catch(ParseException paex){
//    errorLog.logSyntaxError(paex);
//    return new CodeBlock();
//  }
  {
    this.semanticStack.popBlock();
    return new CodeBlock(statements);
  }
}

Statement Statement() :
{Statement stmt=null;
 }
{
    //La gramática comentada acepta la llamada a procedimientos y funciones
    //AssignmentStatement() | ProcedureCall() <SEMICOLON> | FunctionCall() <SEMICOLON> | IfStatement() | CaseStatement() | RepeatStatement() | WhileStatement() | ForStatement()
    try{
        ( stmt=AssignmentStatement() |  stmt=BreakStatement() |  stmt=ContinueStatement() |  stmt=ForStatement() |  stmt=IfStatement() |  stmt=ReadCall() |  stmt=ReadlnCall() |  stmt=WhileStatement() |  stmt=WriteCall() |  stmt=WritelnCall())
    }catch(ParseException paex){
        errorLog.logSyntaxError(paex);
    }
    {
        return stmt;
    }
}



Token TypeIdentifier():
{
    Token type=null;
 }
{
    //La gramatica comentada soporta el uso de tipos definidos por el usuario
    //(<INT_KEYWORD> | <REAL_KEYWORD> | <CHAR_KEYWORD> | <BOOLEAN_KEYWORD> | <IDENTIFIER>) (<LBRACKET> UnsignedNumber() (<COMMA> UnsignedNumber())* <RBRACKET>)?
    try{
    (type=<INT_KEYWORD> | type=<REAL_KEYWORD> | type=<CHAR_KEYWORD> | type=<BOOLEAN_KEYWORD> | type=<STRING_KEYWORD>)
    }catch(ParseException paex){
         errorLog.logSyntaxError(paex);
         return new Token();
    }

    {return type;}
}


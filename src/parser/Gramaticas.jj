WhileStatement WhileStatement():
{
    semanticStack.pushBlock(BlockType.WHILE_BLOCK);
    Expression expr=null;
    Token whileKeyword=null;
    Statement stmt=null;
    CodeBlock codeBlock=null;
}
{
    whileKeyword=<WHILE_KEYWORD>
    try{
        expr=Expression()
        {
            if(expr.getReturnType()!=DataType.BOOLEAN){
                errorLog.logSemanticError(whileKeyword.beginLine,"Se asigno una expresion no BOOLEANA al bloque WHILE");
            }
        }
    }catch(ParseException paex){
         errorLog.logSyntaxError(paex);
    }

    try{
        <DO_KEYWORD>
    }catch(ParseException paex){
        errorLog.logSyntaxError(paex);
    }

    try{
        (
            stmt=Statement() | codeBlock=CodeBlock()
            try{
                <SEMICOLON>
            }catch(ParseException paex){
                errorLog.logSyntaxError(paex);
            }
        )
    }catch(ParseException paex){
        errorLog.logSyntaxError(paex);
    }

    {
     semanticStack.popBlock();
     if(stmt!=null)return new WhileStatement(expr,stmt);
     if(codeBlock!=null)return new WhileStatement(expr,codeBlock);
     return new WhileStatement();
    }
}


void AssignmentStatement():
{
    Variable variable=null;
    Expression expression=null;
}
{
    variable=Variable() <ASSIGN_OP> expression=Expression() <SEMICOLON>
    {
        if(!semanticAnalyzer.checkConstReassignment(variable.getName())){
            //Comprobacion de coincidencia de tipos
        }
    }
}

void IfStatement():
{}
{
    <IF_KEYWORD> Expression() <THEN_KEYWORD> (Statement() | CodeBlock() <SEMICOLON>)  (ElseStatement())?
}

void ElseStatement():
{}
{
    <ELSE_KEYWORD> (Statement() | CodeBlock() <SEMICOLON> )
}


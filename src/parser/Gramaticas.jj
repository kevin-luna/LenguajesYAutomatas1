AssignmentStatement AssignmentStatement():
{
    Variable variable=null;
    Expression expression=null;
    Token assignmentOp=null;
    boolean ok = true;
}
{
    try{
        variable=Variable()
    }catch(ParseException paex){
        ok = false;
         errorLog.logSyntaxError(paex);
     }

    try{
        assignmentOp=<ASSIGN_OP>
        {
            if(assignmentOp!=null && semanticAnalyzer.checkConstReassignment(variable.getName())){
                errorLog.logSemanticError(assignmentOp.beginLine, "Rasignacion de constante "+variable.getName());
            }
        }
    }catch(ParseException paex){
        ok = false;
      errorLog.logSyntaxError(paex);
    }

    try{
        expression=Expression(){
            if(assignmentOp!=null && !semanticAnalyzer.checkAssignment(variable,expression)){
                errorLog.logSemanticError(assignmentOp.beginLine, "No se puede asignar un "+expression.getReturnType()+" a un "+variable.getDataType());
            }
        }
    }catch(ParseException paex){
        ok = false;
      errorLog.logSyntaxError(paex);
    }

    try{
        <SEMICOLON>
    }catch(ParseException paex){
        ok = false;
      errorLog.logSyntaxError(paex);
    }

    {
        if(ok){
            return new AssignmentStatement(variable,expression);
        }
        return new AssignmentStatement();
    }
}

IfStatement IfStatement():
{
        semanticStack.pushBlock(BlockType.IF_BLOCK);
        Expression expr=null;
        Token ifKeyword=null;
        Statement stmt=null;
        CodeBlock codeBlock=null;
        ElseStatement elseStmt=null;
}
{
    try{

    ifKeyword=<IF_KEYWORD> expr=Expression()
    {
        if(expr.getReturnType()!=DataType.BOOLEAN){
            errorLog.logSemanticError(ifKeyword.beginLine, "Se asigno una expresion no BOOLEANA al bloque IF");
            return new IfStatement();
        }
    }
     <THEN_KEYWORD> (stmt=Statement() | codeBlock=CodeBlock() <SEMICOLON>)  (elseStmt=ElseStatement())?
     {

        semanticStack.popBlock();
        if(elseStmt==null){
            if(stmt!=null) return new IfStatement(expr,stmt);
            return new IfStatement(expr,codeBlock);
        }
        if(stmt!=null) return new IfStatement(expr,stmt,elseStmt);
        return new IfStatement(expr,codeBlock,elseStmt);
    }
    }catch(ParseException paex){
         errorLog.logSyntaxError(paex);
         return new IfStatement();
     }
}

ElseStatement ElseStatement():
{
        semanticStack.pushBlock(BlockType.ELSE_BLOCK);
        Statement statement=null;CodeBlock codeBlock=null;
}
{
    <ELSE_KEYWORD>

    try{
        (statement=Statement() | codeBlock=CodeBlock() <SEMICOLON> )
    }catch(ParseException paex){
         errorLog.logSyntaxError(paex);
    }

    {
        semanticStack.popBlock();
        if(statement!=null)return new ElseStatement(statement);
        if(codeBlock!=null)return new ElseStatement(codeBlock);
        return new ElseStatement();
    }
}

